# ==============================================================================
# AdatTracker Pro — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub — it contains your secrets.
# ==============================================================================

# ── Application Environment ───────────────────────────────────────────────────
# Options: local | production
APP_ENV=local

# ── Network ───────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── IMPORTANT: Set to your real public domain before going live ───────────────
# For Cloudflare Tunnel: https://habits.yourdomain.com
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_random_64_char_hex_string

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database file directory (must be on persistent storage)
DATA_DIR=/app/data

# ── Email Backend ─────────────────────────────────────────────────────────────
# Options: console | resend | smtp
# console: Prints OTP to container logs (safe for local dev/testing — no SMTP needed)
# resend:  Recommended for production (free tier: 3000 emails/month at resend.com)
# smtp:    SMTP relay (Gmail App Passwords, Amazon SES, Mailgun, Brevo, etc.)
EMAIL_BACKEND=console

# ── Resend API (EMAIL_BACKEND=resend) ─────────────────────────────────────────
# RESEND_API_KEY=re_your_key_here
# FROM_EMAIL=noreply@yourdomain.com
# FROM_NAME=AdatTracker Pro

# ── SMTP Settings (EMAIL_BACKEND=smtp) ────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password_here
# SMTP_TLS=true
# FROM_EMAIL=you@gmail.com
# FROM_NAME=AdatTracker Pro

# ── Docker Production: Bind port to localhost only (Cloudflare Tunnel) ────────
# Set this to 127.0.0.1 in production so port 8000 is NOT publicly reachable.
# Leave as 0.0.0.0 for homelab/local access.
# BIND_HOST=127.0.0.1

# ── Session ───────────────────────────────────────────────────────────────────
# SESSION_MAX_AGE_DAYS=30
# COOKIE_SECURE=true   # auto-enabled when APP_ENV=production

# ── Hosted Razorpay Subscriptions (UPI AutoPay ₹21/month) ─────────────────────
# Leave BILLING_ENABLED=false for free local/self-hosted installations.
# Set BILLING_ENABLED=true for paid hosted Cloudflare/Oracle deployments.
BILLING_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_PLAN_ID=plan_your_plan_id_here
HOSTED_PRICE=21
HOSTED_CURRENCY=INR

