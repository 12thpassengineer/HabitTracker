# ==============================================================================
# AdatTracker Pro - Environment Variable Configuration Template
# Copy this file to .env and customize for your environment
# ==============================================================================

# Application Environment: "local" (for development/self-hosting) or "production" (for Cloudflare/Oracle Cloud)
APP_ENV=local

# 64-character random hex secret for HMAC hashing and CSRF tokens (REQUIRED in production)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_64_character_random_hex_key

# Network Configuration
PORT=8000
HOST=0.0.0.0
BASE_URL=http://localhost:8000

# Strict CORS Allowed Origins (Comma-separated list of exact domains, e.g. https://habits.yourdomain.com)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cookie Security (Auto-enabled in production, can be manually forced here)
COOKIE_SECURE=false
SESSION_MAX_AGE_DAYS=30

# Email Backend: "console" (prints OTP to terminal for local dev), "smtp", or "resend"
EMAIL_BACKEND=console

# SMTP Configuration (Used when EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_TLS=true
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME="AdatTracker Pro"

# Resend API Key (Used when EMAIL_BACKEND=resend)
RESEND_API_KEY=re_123456789
